# Application
APP_NAME=awesome-project
DEBUG=false
API_PREFIX=/api/v1

# Database
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/awesome
# 学情业务库。聊天问数及学校、知识点等管理功能使用这一条连接。
DATABASE_EDU_URL=postgresql://postgres:postgres@127.0.0.1:15435/edu

# JWT
JWT_SECRET_KEY=your-secret-key-change-in-production
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=1440

# 智能问数。输出上限不设宽裕值时，长思考和工具调用 JSON 会被截断。
LLM_CHAT_BASE_URL=http://localhost:11434/v1
LLM_CHAT_API_KEY=ollama
LLM_CHAT_MODEL=qwen2.5
LLM_CHAT_MAX_TOKENS=8192
# 可选模型调用上限。未设置时沿用 DeepAgents 的图执行上限。
# CHAT_MAX_STEPS=60
# 可选任务总 Token 上限。留空时不设任务 Token 上限。
# CHAT_MAX_TOTAL_TOKENS=200000
# 思考模式：disabled / adaptive。仅部分模型支持。留空则不发送该参数。
# LLM_CHAT_THINKING=disabled
# 知识点匹配。核对只需要短 JSON。
LLM_MATCH_BASE_URL=http://localhost:11434/v1
LLM_MATCH_API_KEY=ollama
LLM_MATCH_MODEL=qwen2.5
LLM_MATCH_MAX_TOKENS=512
# MiniMax-M3.1-Flash 不允许 disabled，需要 adaptive。其他模型留空则不发送该参数。
# LLM_MATCH_THINKING=adaptive
# 试卷 AI 识别
LLM_PAPER_BASE_URL=http://localhost:11434/v1
LLM_PAPER_API_KEY=ollama
LLM_PAPER_MODEL=qwen2.5
LLM_PAPER_MAX_TOKENS=8192
# LLM_PAPER_THINKING=adaptive

# Required for Q&A on each datasource. Use published bundle IDs and full manifest SHA-256 hashes.
# DATASEMANTIC_URL=http://127.0.0.1:8090
# DATASEMANTIC_TOKEN=
# DATASEMANTIC_BINDINGS={"1":{"bundle_id":"education-v1","manifest_hash":"<64 lowercase hex characters>"}}

# DataAnalyst mid-run direction fork: off / shadow / on.
# EDU_DA_QUESTION_MODE=shadow

# 侧边栏「系统文档」。留空则使用代码内默认地址，修改后重启服务生效。
EDU_DOC_COMMITMENT_URL=https://edu.wegoo.ltd:28433/docs/xtsycns.docx
EDU_DOC_TRAINING_URL=https://edu.wegoo.ltd:28433/docs/xqfxxtpxsp.mp4
EDU_DOC_MANUAL_URL=https://edu.wegoo.ltd:28433/docs/yhsc.docx
