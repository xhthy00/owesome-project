  "cards": [
    {
      "dot": "cyan",
      "title": "问数主链路",
      "items": [
        "浏览器订阅 /chat/chat-stream，接收进度、结果、图表与追问事件",
        "DeepAgents 先用 question_assessment 评估查询条件，必要时经 ask_human 中断并恢复",
        "DataSemantic 把逻辑 SQL 编译成只读物理 SQL，行/列权限与脱敏在真正执行前生效"
      ]
    },
    {
      "dot": "emerald",
      "title": "学情报告与导出",
      "items": [
        "ReportOrchestrator 按 ReportSpec 查库、统计、出图，再渲染 Jinja2 模板，全程不依赖 LLM",
        "报告 HTML 在浏览器端截图为 PDF（html2canvas + jsPDF），同一截图嵌入 .doc 导出",
        "成绩、试卷、知识点导入同样走教育库读写，试卷识别用 paper 模块的视觉模型"
      ]
    },
    {
      "dot": "amber",
      "title": "数据与审计",
      "items": [
        "系统库保存账号、工作区、会话记录与 LangGraph checkpoint；教育库保存成绩/学校/考试明细",
        "access、operation、login 三类审计日志 + tool_call_log 记录每次 Agent 工具调用",
        "工作区 oid 做多租户隔离，数据源权限按表/字段授权，教育权限再按学校与班级收敛"
      ]
    },
    {
      "dot": "violet",
      "title": "模型接入",
      "items": [
        "chat / match / paper 三套独立模型配置，可指向 OpenAI 兼容服务或 Ollama",
        "match 模块负责知识点核对，paper 模块负责试卷 PDF/图片转写"
      ]
    }
  ]
}
